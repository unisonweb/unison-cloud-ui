{
  "name": "unison-cloud-ui",
  "version": "1.0.0",
  "description": "Unison Cloud UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unisoncomputing/unison-cloud-ui.git"
  },
  "scripts": {
    "build": "webpack --mode production --config webpack.prod.js",
    "clean": "rm -rf dist",
    "start": "webpack serve --mode development --port 2222 --config webpack.dev.js",
    "test": "elm-test",
    "check": "elm-test; elm-review; ui-core-check-css; prettier --check .",
    "review": "elm-review",
    "build-maintenance-mode": "rm -rf dist; mkdir -p dist/unisonCloud; cp src/maintenance.html dist/unisonCloud/index.html",
    "repl": "elm repl",
    "ui-core-check-css": "ui-core-check-css",
    "ui-core-install": "ui-core-install",
    "ui-core-update": "ui-core-update",
    "postinstall": "ui-core-install"
  },
  "homepage": "https://unison.cloud",
  "devDependencies": {
    "@csstools/postcss-global-data": "^3.0.0",
    "@octokit/core": "^6.1.4",
    "@unison-lang/ui-core-scripts": "^1.1.9",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "elm": "^0.19.1-5",
    "elm-asset-webpack-loader": "^1.1.2",
    "elm-format": "^0.8.5",
    "elm-git-install": "^0.1.4",
    "elm-json": "^0.2.12",
    "elm-review": "^2.5.5",
    "elm-test": "^0.19.1-revision15",
    "elm-webpack-loader": "^8.0.0",
    "favicons": "^7.0.1",
    "favicons-webpack-plugin": "^6.0.0-alpha.1",
    "html-webpack-plugin": "^5.3.1",
    "postcss": "^8.4.16",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.5",
    "prettier": "^3.5.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.66.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "tar": "^7.5.7",
    "form-data": "^4.0.1",
    "qs": "^6.14.1",
    "tough-cookie": "^5.0.0"
  }
}
