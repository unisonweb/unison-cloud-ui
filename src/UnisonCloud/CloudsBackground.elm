module UnisonCloud.CloudsBackground exposing (view)

import Html exposing (Html, div)
import Html.Attributes exposing (class, id)
import Svg exposing (defs, g, path, rect, svg)
import Svg.Attributes
    exposing
        ( clipPath
        , clipRule
        , d
        , fill
        , fillRule
        , height
        , transform
        , viewBox
        , width
        )


type CloudLayer
    = Background
    | Middleground
    | Foreground


viewClouds : CloudLayer -> Html msg
viewClouds layer =
    let
        ( class_, id_ ) =
            case layer of
                Background ->
                    ( "background", "bg" )

                Middleground ->
                    ( "middleground", "mg" )

                Foreground ->
                    ( "foreground", "fg" )
    in
    div [ class "clouds", class class_ ]
        [ svg
            [ width "100%", height "50%", viewBox "0 0 1024 512", fill "none" ]
            [ g [ clipPath ("url(#clouds-" ++ id_ ++ ")") ]
