16.66 75.514L1016.65 75.4976L1016.65 75.4899C1006.86 58.5075 988.751 48.0451 969.161 48.0451C954.549 48.0451 941.054 40.2941 933.677 27.7044C933.632 27.6199 933.586 27.5359 933.538 27.4525Z", fill "currentColor" ] []
                ]
            , defs []
                [ Svg.clipPath [ id ("clouds-" ++ id_) ]
                    [ rect [ width "1024", height "512", fill "currentColor", transform "matrix(-1 0 0 1 1024 0)" ] []
                    ]
                ]
            ]
        ]


view : Html msg
view =
    div [ class "clouds-background" ]
        [ viewClouds Background
        , viewClouds Middleground
        , viewClouds Foreground
        ]
